# Environment & Secrets (CRITICAL: Do not commit secrets)
.env
.env.local
.env.*.local
*.env

# SQLite Database & Backups (Keep data private)
database/*.db
database/backups/
*.sqlite
*.sqlite3
*.db-journal

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
env/
ENV/
.venv/

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Dynamic User Uploads (keep directory structure with .gitkeep)
# static/uploads/*
# !static/uploads/


# Ignore uploaded user files, but keep folder placeholders
static/uploads/*
!static/uploads/**/
!static/uploads/**/.gitkeep

# Ignore uploaded user files; keep empty folder placeholders
static/uploads/*
!static/uploads/**/
!static/uploads/**/.gitkeep
static/uploads/
