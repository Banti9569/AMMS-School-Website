# =====================================================================
# AL MAJID MISSION SCHOOL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# Flask Core & Security
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=generate_your_secure_secret_key_here

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database & Storage
DATABASE_PATH=database/school.db
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH_MB=16

# School Identity & Contact Details
SCHOOL_NAME=Al Majid Mission School
SCHOOL_TAGLINE=Nurturing Character, Fostering Knowledge, Inspiring Leadership
SCHOOL_ADDRESS=Hazipur, P.O. Hazipur, Dist. Murshidabad/Birbhum Border, West Bengal - 731245
SCHOOL_PHONE=+91 94340 56789, +91 98765 43210
SCHOOL_EMAIL=info@almajidmissionschool.edu.in
SCHOOL_HOURS=Monday - Saturday: 8:00 AM - 3:30 PM (Friday: 8:00 AM - 12:00 PM)

# Optional Initial Seed Passwords (for fresh deployments)
# ADMIN_INITIAL_PASSWORD=your_secure_admin_password
# PARENT_INITIAL_PASSWORD=your_secure_parent_password

